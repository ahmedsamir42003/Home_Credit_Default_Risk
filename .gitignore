# .gitignore

# ── DVC cache & local config ───────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ── Raw data folders (actual files ignored, .dvc pointers are tracked) ────
data/inputs/**
data/outputs/**
# Allow .dvc pointer files and .gitkeep markers anywhere under data/
!data/**/*.dvc
!data/**/.gitkeep

# ── MLflow local artefacts ─────────────────────────────────────────────────
mlruns/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# ── Notebooks / IDE ────────────────────────────────────────────────────────
.ipynb_checkpoints/
.idea/
.vscode/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db