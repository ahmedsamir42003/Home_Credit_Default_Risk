# ── DVC cache & local config ───────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ── Raw data (tracked by DVC, not git) ────────────────────────────────────
data/inputs/
data/outputs/
# Keep the .dvc pointer files:
!data/inputs/.gitkeep
!data/outputs/.gitkeep

# ── MLflow local artefacts ─────────────────────────────────────────────────
mlruns/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# ── Notebooks / IDE ────────────────────────────────────────────────────────
.ipynb_checkpoints/
.idea/
.vscode/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── data ─────────────────────────────────────────────────────────────────────
data/
*.parquet
*.csv
*.pkl
.venv/
__pycache__/

